  const double PI = 3.14159; 
	double radius = 10;
	double circumference = 2 * PI * radius;

  const double GRAVITY = 9.81;
	const double SPEED_OF_LIGHT = 299792458; // in meters per second
	const double PLANCK_CONSTANT = 6.62607015e-34; // in joule-seconds
	const double AVOGADRO_NUMBER = 6.02214076e23; // in particles per mole
