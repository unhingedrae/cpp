example 2:

#include<iostream>
#include<string>
#include<ctime> 
#include<iomanip>


int main() {

	using namespace std;

	string foods[5]; 
	int size = sizeof(foods) / sizeof(string);
	string temp;

	for (int i = 0; i < size; i++) {
		cout << "enter the food you like or press 'q' to quit! :( " << i + 1 << ": ";
		getline(cin, temp);
		if (temp == "q") {
			break;
		}
		else {
			foods[i] = temp;
		}
	}
	cout << "oh you like \n";

	for (int i = 0; !foods[i].empty(); i++) {
		cout << foods[i] << '\n';
	}

	return 0;
}
