#include<iostream>
#include<string>

int main() 
{
	using namespace std;

	// break = break out of loop
	// continue = skip the current iteration of the loop and continue with the next iteration

	for (int i = 1; i <= 20; i++) {
		if (i == 13) {
			break; // break out of the loop when i is 13 (reads from 1 to 12)
		}
		cout << i << '\n';
	}

	for (int i = 1; i <= 20; i++) {
		if (i == 13) {
			continue; // reads from 1 to 20 but skips number 13
		}
		cout << i << '\n';
	}

	return 0;
}
