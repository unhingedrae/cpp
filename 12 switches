#include<iostream>

int main() 
{
	using namespace std;

	//switches = alternative for using many "else if" statements
	//           compare one value against matching cases. 

	char grade;
	cout << "enter your grade between A to F: ";
	cin >> grade; 

	switch (grade) {
	case 'A':
		cout << "you did awesome!";
		break;
	case 'B':
		cout << "you did good!";
		break;
	case 'C':
		cout << "you did okayish!";
		break;
	case 'D':
		cout << "you did well! but can be good next time!";
		break;
	case 'F':
		cout << "better luck next time! try harder!";
		break;
	default:
		cout << "type in your grade between A to F! i told you right?";
	}

	return 0;
}
