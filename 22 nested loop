#include<iostream>
#include<string>

int main() 
{
	using namespace std;

	// nested loop is just a loop inside another loop, it doesnt matter what kind of loop it is, it can be a for loop, while loop or do while loop

	int rows;
	int columns;
	char symbol;

	cout << "how many rows do you want?: ";
	cin >> rows;

	cout << "how many columns do you want?: ";
	cin >> columns;

	cout << "what symbol do you want to use?: ";
	cin >> symbol;

	for (int i = 1; i <= rows; i++) {
		for (int j = 1; j <= columns; j++) {
			cout << symbol << ' ';
		}
		cout << '\n';
	}
	

	return 0;
}
