#include<iostream>
#include<string>
#include<ctime> 
#include<iomanip>


int main() {

	using namespace std;

	const int size = 100;
	string foods[size]; 

	fill(foods, foods + (size/2), "burger");
	fill(foods + (size / 2), foods + size, "cola");


	for (string food : foods) {
		cout << food << '\n';
	}

	return 0;
}


example 3

#include<iostream>
#include<string>
#include<ctime> 
#include<iomanip>


int main() {

	using namespace std;

	const int size = 99;
	string foods[size]; 

	fill(foods, foods + (size/3), "burger");
	fill(foods + (size / 3), foods + (size/3)*2, "cola");
	fill(foods + (size / 3)*2, foods + size, "hotdog");


	for (string food : foods) {
		cout << food << '\n';
	}

	return 0;
}

