#include<iostream>
#include<string>
#include<ctime> 
#include<iomanip>


int main() {

	using namespace std;

	//fill() = fills a range of elements with a specified value
	//         fill(begin, end, value)

	string foods[100]; //= { "burger", "cola", "fanta", "pasta", "fries", "celery", "vegemite", "lasgna", "ribs", "pork" };

	fill(foods, foods + 100, "burger");


	for (string food : foods) {
		cout << food << '\n';
	}

