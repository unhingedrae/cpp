#include<iostream>
#include<string>
#include<ctime> 
#include<iomanip>
#include<cctype>

using namespace std;

void swap(string &x, string &y);

int main() {

	string x = "fanta";
	string y = "cola";
	
	swap(x, y);

	cout << "x: " << x << '\n';
	cout << "y: " << y << '\n';

	//what if we create a function to swap two variables?

	return 0;
}
void swap(string &x, string &y) {
	
	string temp;

	temp = x;
	x = y;
	y = temp;
}

