#include<iostream>
#include<string>
#include<ctime> 
#include<iomanip>

double getTotal(double prices[], int size);

int main() {

    using namespace std;

	double prices[] = { 59.33, 66.78, 87.30, 14.25, 74.36 }; //we will create a function to find the sum of these prices
	int size = sizeof(prices) / sizeof(prices[0]);
	double total = getTotal(prices, size);

	cout << "$" << total;

	return 0;
}

double getTotal(double prices[], int size) {
	double total = 0;

	for (int i = 0; i < size ; i++) {

		total += prices[i]; 
	}

	return total;
}
