#include<iostream>
#include<string>
#include<ctime> 

using namespace std;

int myNum = 3; // global variable

void printNum();

int main() 
{
	int myNum = 2; // local variable
	printNum();
	cout << ::myNum << '\n';


	//local variables = declared inside a function or block {}
	//global variables = declared outside of all functions and blocks {}

	return 0;
}
void printNum() {
	int myNum = 1; // local variable
	cout << ::myNum << '\n';
}


//its best to avoid global variable if you can, cause it pollutes the global namespace and
//also variables declared within a function are much more secure cause functions can only access
