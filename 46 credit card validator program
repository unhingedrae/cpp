//Luhn Algorithm
/*(1) double every second digit from right to left, if doubled number is 2 digits, split them
  (2) add all single digits from step (1)
  (3) add all odd numbered digits from right to left 
  (4) sum results from step (2) and (3)
  (5) if step (4) is divisible by 10, # is valid */

/* for example:    6011     0009     9013     9424 
        step 1:    1 2 2    0 0      1 8 2    1 8 4
		step 2:    29
		step 3:     0 1      09       03       44
		step 4:    21
		step 5:    50 % 10 = valid*/

#include<iostream>
#include<string>
#include<ctime> 
#include<iomanip>
#include<cctype>

using namespace std;

int getDigit(const int number);
int sumOddDigits(const string cardNumber);
int sumEvenDigits(const string cardNumber);
int main() {

	string cardNumber;
	int result = 0;

	cout << "enter your credit card number please: " << '\n';
	cin >> cardNumber;

	result = sumEvenDigits(cardNumber) + sumOddDigits(cardNumber);

	if (result % 10 == 0) {
		cout << cardNumber << " is valid";
	}
	else {
		cout << cardNumber << " is not valid"; 
	}

	return 0;
}
int getDigit(const int number) {

	return number % 10 + (number / 10 % 10);
}
int sumOddDigits(const string cardNumber) {

	int sum = 0;

	for (int i = cardNumber.size() - 1; i >= 0; i -= 2) {
		sum += cardNumber[i] - '0';
	}

	return sum;
}
int sumEvenDigits(const string cardNumber) {

	int sum = 0;

	for (int i = cardNumber.size() - 2; i >= 0; i -= 2) {
		sum += getDigit((cardNumber[i] - '0') * 2);
	}

	return sum;
}


    
