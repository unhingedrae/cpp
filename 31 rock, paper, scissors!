using namespace std;

char getUserChoice(){

	char player;
	cout << "Rock - Paper - Scissors Game!\n";

	do {
		cout << "select your choice!:\n";
		cout << "'r' - Rock\n";
		cout << "'p' - Paper\n";
		cout << "'s' - Scissors\n";
		cin >> player;
	} while(player != 'r' && player != 'p' && player != 's');
	

	return player;

}
char getComputerChoice(){

	srand(time(0));
	int num = rand() % 3 + 1;

	switch (num) {
	case 1:
		return 'r';
		break;
	case 2:
		return 'p';
		break;
	case 3:
		return 's';
		break;
	}

	return 0;
}
void showChoice(char choice) {

	switch(choice){
	case 'r':
		cout << "Rock\n";
		break;
	case 'p':
		cout << "Paper\n";
		break;
	case 's':
		cout << "Scissors\n";
	}
	
}
